Bootstrap: docker
From: ubuntu:22.04

# Apptainer/Singularity image with all SYSTEM dependencies to build & run
# Craftium (Minetest) headless. The Python venv (torch + craftium) is built
# separately INTO your scratch PERSIST checkout (see hprc/setup_env.sh), so this
# image only carries the OS libraries + build toolchain + uv + Xvfb.
#
# Build (on an HPRC build node or with fakeroot):
#   apptainer build $SCRATCH/craftium.sif hprc/craftium.def

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y \
        g++ make libc6-dev cmake fontconfig libpng-dev libjpeg-dev \
        libgl1-mesa-dev libgles2-mesa-dev libsqlite3-dev libglfw3-dev \
        libogg-dev libvorbis-dev libopenal-dev libcurl4-gnutls-dev \
        libfreetype6-dev zlib1g-dev libgmp-dev libjsoncpp-dev libzstd-dev \
        libluajit-5.1-dev gettext libsdl2-dev libpython3-dev python3-dev \
        xvfb git curl ca-certificates build-essential pkg-config ffmpeg
    # Craftium expects a recent SDL2; build 2.28.5 from source (matches the
    # PERSIST install guide).
    cd /tmp && git clone https://github.com/libsdl-org/SDL.git SDL2 && cd SDL2 && \
        git checkout release-2.28.5 && mkdir -p build && cd build && \
        cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local && \
        make -j"$(nproc)" && make install && ldconfig && rm -rf /tmp/SDL2
    # uv (Python/deps manager) into a system path.
    curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh
    chmod -R a+rx /usr/local/bin || true

%environment
    export LC_ALL=C
    export PATH=/usr/local/bin:$PATH

%labels
    Purpose Craftium/PERSIST headless dataset generation on HPRC
